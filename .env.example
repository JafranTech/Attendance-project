# Environment Variables — Attendance PWA Backend

# ── Supabase ──────────────────────────────────────────────────────────────────
# Either name is accepted (SUPABASE_URL takes priority)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=        # optional alias

# Either name is accepted (SUPABASE_SERVICE_ROLE_KEY takes priority)
# Use the service_role secret key (NOT the anon/public key)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=            # optional alias

# ── JWT ───────────────────────────────────────────────────────────────────────
# Either name is accepted (JWT_SECRET takes priority)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
AUTH_JWT_SECRET=                 # optional alias

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
